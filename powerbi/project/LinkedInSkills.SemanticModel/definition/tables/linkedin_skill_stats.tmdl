	partition linkedin_skill_stats = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "linkedin_skill_stats.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"role", type text}, {"skill_name", type text}, {"n_with", Int64.Type}, {"demand_pct", type number}}, "en-US")
				in
					Typed

